{
  // This file provides editor support and typechecking without depending on node_modules being pre-built
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "@site/*": ["./*"],
      "@theme/*": ["./src/theme/*"],
      "@theme-original/*": ["./src/theme/*"]
    }
  },
  "include": ["src", "docs", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": [".docusaurus", "build", "node_modules"]
}
